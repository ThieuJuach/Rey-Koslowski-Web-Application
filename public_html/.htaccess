# ============================================================
# Rey Koslowski Academic Website
# Apache Configuration for XAMPP / Production
# OWASP Security Headers & Hardening
# ============================================================

# Enable URL rewriting
RewriteEngine On

# ── Canonical URL enforcement (SEO: avoid duplicate content) ──
# Search engines treat http/https and www/non-www as different sites unless they are
# redirected. Serving the same page on several URLs splits ranking signals and shows
# up in Search Console as duplicate / "Alternate page with proper canonical" notices.
# Both rules use 301 so the consolidation is permanent.

# 1. Force HTTPS. HTTP_X_FORWARDED_PROTO covers Hostinger's load balancer, which
#    terminates TLS upstream and would otherwise make %{HTTPS} read "off" forever.
#    Local hostnames are exempt so a plain-HTTP XAMPP install still works.
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. Strip a leading www. so only one hostname is canonical.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ── Sitemap ──
# /sitemap.xml is now generated by sitemap.php so <lastmod> reflects real content
# changes. The .xml URL is preserved because it is already submitted to Search Console.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ── Keep non-production hosts out of search results ──
# The staging site runs the identical codebase, so without this it would serve
# the same crawl-permitting robots.txt and compete with the real domain. Any
# host other than the canonical one gets a Disallow-all file instead.
RewriteCond %{HTTP_HOST} !^reykoslowski\.com$ [NC]
RewriteCond %{HTTP_HOST} !^www\.reykoslowski\.com$ [NC]
RewriteRule ^robots\.txt$ robots-staging.txt [L]

# ── Custom error pages (SEO: return real 404s, not soft 404s) ──
ErrorDocument 404 /404.php

# ── Protect Sensitive Files (OWASP: Information Disclosure) ──
<FilesMatch "\.(sql|log|ini|env|json|lock|bak|old|tmp|md|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow robots.txt and sitemap.xml to be publicly accessible
<Files "robots.txt">
    Order Allow,Deny
    Allow from all
</Files>
<Files "sitemap.xml">
    Order Allow,Deny
    Allow from all
</Files>

# Protect config and secrets files from direct access
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>
# secrets.php normally lives ABOVE the web root; this is belt-and-braces in case a
# copy ever ends up in public_html on a host that cannot write above it.
<Files "secrets.php">
    Order Allow,Deny
    Deny from all
</Files>

# Protect sensitive directories
RewriteRule ^includes/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^database/ - [F,L]

# Block access to hidden files (.git, .env, etc.)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Set default charset
AddDefaultCharset UTF-8

# Prevent directory listing (OWASP: Information Disclosure)
Options -Indexes

# Disable server signature (OWASP: Information Disclosure)
ServerSignature Off

# ── Security Headers (OWASP Secure Headers) ──
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # XSS filter (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions policy (restrict browser features)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none';"
    
    # Strict Transport Security (HTTPS only — 1 year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # Remove PHP version header
    Header always unset X-Powered-By
</IfModule>

# ── Hide PHP version ──
<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>

# ── MIME types ──
# Some older Apache builds do not know .webp and serve it as octet-stream, which
# makes the browser skip the <source> and silently fall back to the larger JPEG.
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType application/xml .xml
</IfModule>

# ── Enable GZIP compression ──
# Text assets only. Images and PDFs are already compressed, so re-compressing them
# costs CPU and saves nothing.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache static assets ──
# Images are content-addressed (hashed filenames) or versioned by hand, so they can
# be cached hard. CSS/JS use a shorter window because their filenames are stable.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Mark long-lived, immutable assets so browsers skip even the revalidation request.
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ── Limit upload size (20MB) ──
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
</IfModule>
