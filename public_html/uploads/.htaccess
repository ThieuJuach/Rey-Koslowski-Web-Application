# ============================================================
# Uploads Directory Security (OWASP: Unrestricted File Upload)
# ============================================================

# Disable PHP execution in uploads directory — prevents uploaded shell scripts
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Block .php, .phtml, .php5, .phar, etc. from being accessed directly
<FilesMatch "\.(php|phtml|php5|php7|phar|cgi|pl|py|sh|bash)$">
    # Dual syntax on purpose. The bare 2.2 form 500s on an Apache 2.4 host that
    # does not load mod_access_compat - and because this file governs the
    # uploads folder, that 500 takes every image and PDF on the site with it.
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable script execution
Options -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .phar

# Force PDFs to display inline (no download prompt)
<IfModule mod_headers.c>
    <FilesMatch "\.pdf$">
        Header set Content-Disposition "inline"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes
